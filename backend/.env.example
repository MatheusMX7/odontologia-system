# Copie para .env e ajuste. NUNCA versione o .env real.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/odontologia
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao
ACCESS_TOKEN_MINUTES=480
# Em produção (HTTPS) use true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TIMEZONE=America/Recife
UPLOAD_DIR=uploads
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
